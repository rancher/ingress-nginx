#!/bin/bash
set -o errexit
set -o pipefail

source "$(dirname "$0")/version"

cd "$(dirname "$0")/.."

TAG=${NGINX_TAG}-e2e

missing_libs=$(docker run --rm --entrypoint /bin/bash rancher/nginx:${TAG} -c '
  shopt -s nullglob globstar
  required_targets=(
    /usr/lib64/ossl-modules/fips.so
  )
  targets=(
    /usr/local/nginx/sbin/nginx
    /etc/nginx/modules/*
    /usr/local/lib/*.so*
    /usr/local/lib64/*.so*
    /usr/local/lib/lua/**/*.so
    /usr/lib64/libopentelemetry*.so*
    /usr/lib64/libbrotli*.so*
    "${required_targets[@]}"
    /opt/**/*.so*
  )

  for target in "${required_targets[@]}"; do
    if [[ ! -e "${target}" ]]; then
      printf "Required runtime target is missing: %s\n" "${target}" >&2
      exit 1
    fi
  done

  if ! openssl list -providers -provider fips >/dev/null 2>&1; then
    printf "OpenSSL FIPS provider failed to load\n" >&2
    exit 1
  fi

  for target in "${targets[@]}"; do
    [[ -e "${target}" ]] || continue
    printf "=== %s ===\n" "${target}"
    ldd "${target}"
  done
')

echo "$missing_libs" | awk '
/^=== / {
  module = $2;
  next
}
/=> not found/ { 
  print "Runtime target " module " is missing library: " $1
}'

if echo "$missing_libs" | grep -q "not found"; then
  exit 1
fi